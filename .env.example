# Скопируйте в .env (файл в .gitignore — не коммитить).
# Ключи НЕ класть в ClubOfSisters/, GitHub Pages и публичный git.

# --- DeepSeek (основной путь для статей из переписки) ---
# Ключ: https://platform.deepseek.com/api_keys
# История чатов с chat.deepseek.com через API не читается:
# экспортируйте JSON/MD и положите в _inbox/, затем:
#   python3 tools/deepseek_to_post.py _inbox/ваш-файл.json
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- GigaChat (запасной вариант, как в ClubOfSisters) ---
# Studio → Настройки API → Authorization Key (уже Base64).
# GIGACHAT_AUTHORIZATION_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-3-Ultra
