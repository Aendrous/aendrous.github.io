# Скопируйте в .env (файл в .gitignore — не коммитить).
# Ключи НЕ класть в ClubOfSisters/, GitHub Pages, _writer/ и публичный git.

# --- DeepSeek (статьи из переписки) ---
# Ключ: https://platform.deepseek.com/api_keys
# История чатов с chat.deepseek.com через API не читается:
# экспортируйте JSON/MD в _inbox/, затем:
#   python3 _writer/publish_from_chat.py _inbox/ваш-файл.json
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- GigaChat (как в ClubOfSisters Story Keeper) ---
# Studio → Настройки API → Authorization Key (уже Base64).
# Только локальный .env.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
